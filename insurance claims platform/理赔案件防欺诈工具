# 数据库初始化
DB_PATH = "claims.db"

def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS claims
                 (claim_no TEXT PRIMARY KEY,
                  policy_no TEXT,
                  insured TEXT,
                  applicant TEXT,
                  receiver_account TEXT,
                  product_name TEXT,
                  product_code TEXT,
                  insurance_name TEXT,
                  insurance_code TEXT,
                  sum_insured REAL,
                  deductible REAL,
                 赔付比例 REAL,
                  reported_amount REAL,
                  settlement_amount REAL)''')
    conn.commit()
    conn.close()

init_db()

# DeepSeek客户端（需配置环境变量或前端传入）
deepseek_client = None

def get_deepseek_client(api_key):
    if not api_key:
        return None
    return OpenAI(api_key=api_key, base_url="https://api.deepseek.com")

def get_all_cases():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT * FROM claims")
    rows = c.fetchall()
    columns = [desc[0] for desc in c.description]
    conn.close()
    cases = [dict(zip(columns, row)) for row in rows]
    return cases

def add_case(case_data):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    try:
        c.execute('''INSERT INTO claims VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)''',
                  (case_data['claim_no'], case_data['policy_no'], case_data['insured'],
                   case_data['applicant'], case_data['receiver_account'], case_data['product_name'],
                   case_data['product_code'], case_data['insurance_name'], case_data['insurance_code'],
                   case_data['sum_insured'], case_data['deductible'], case_data['赔付比例'],
                   case_data['reported_amount'], case_data['settlement_amount']))
        conn.commit()
        conn.close()
        return True
    except sqlite3.IntegrityError:
        conn.close()
        return False

def delete_case(claim_no):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("DELETE FROM claims WHERE claim_no = ?", (claim_no,))
    conn.commit()
    conn.close()

def get_group_stats(cases):
    """
    生成用于DeepSeek分析的分组统计数据
    包括：按保单号、按被保险人（保险标的）、按收款账号的统计，
    以及按天、周、月的时间维度统计
    """
    df = pd.DataFrame(cases)
    if df.empty:
        return {
            "policy_stats": [],
            "insured_stats": [],
            "account_stats": [],
            "daily_stats": [],
            "weekly_stats": [],
            "monthly_stats": []
        }
    
    # 确保日期字段（如果案件有报案日期，但字段中没有明确日期字段，使用当前模拟？由于原始字段没有日期，但为了时间维度需求，我们额外添加一个报案日期字段。
    # 实际中理赔案件应有报案日期，但需求字段未包含，为满足时间维度，我们添加一个默认字段：创建时间或从报案号解析？由于要求按天周月统计，我们需要案件日期。
    # 为演示完整性，在数据库中添加一个report_date字段，默认使用当前日期或解析报案号中的日期。但需求未强制，但为了功能实现，增加report_date字段。
    # 调整数据库结构，增加report_date字段，默认使用当前日期。用户上传时可以手动添加或默认为当天。
    # 重构init_db，增加report_date TEXT NOT NULL DEFAULT (date('now'))
    # 注意：必须重新初始化或迁移。为了方便，这里修改代码自动迁移。
    # 我们将在init_db中添加report_date列（如果不存在）
    
    # 确保report_date存在
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    try:
        c.execute("ALTER TABLE claims ADD COLUMN report_date TEXT DEFAULT (date('now'))")
        conn.commit()
    except:
        pass
    conn.close()
    
    # 重新获取数据并转换日期
    cases = get_all_cases()
    df = pd.DataFrame(cases)
    if 'report_date' not in df.columns:
        df['report_date'] = datetime.now().strftime('%Y-%m-%d')
    df['report_date'] = pd.to_datetime(df['report_date'])
    
    # 保单号分组统计
    policy_stats = []
    for policy, group in df.groupby('policy_no'):
        if pd.isna(policy) or policy == '':
            continue
        stats = {
            "policy_no": policy,
            "case_count": len(group),
            "total_amount": group['settlement_amount'].sum(),
            "avg_amount": group['settlement_amount'].mean(),
            "cases": group['claim_no'].tolist()
        }
        policy_stats.append(stats)
    
    # 保险标的（被保险人）分组统计
    insured_stats = []
    for insured, group in df.groupby('insured'):
        if pd.isna(insured) or insured == '':
            continue
        stats = {
            "insured": insured,
            "case_count": len(group),
            "total_amount": group['settlement_amount'].sum(),
            "avg_amount": group['settlement_amount'].mean(),
            "cases": group['claim_no'].tolist()
        }
        insured_stats.append(stats)
    
    # 收款账号分组统计
    account_stats = []
    for account, group in df.groupby('receiver_account'):
        if pd.isna(account) or account == '':
            continue
        stats = {
            "receiver_account": account,
            "case_count": len(group),
            "total_amount": group['settlement_amount'].sum(),
            "avg_amount": group['settlement_amount'].mean(),
            "cases": group['claim_no'].tolist()
        }
        account_stats.append(stats)
    
    # 按天统计
    daily_stats = df.groupby(df['report_date'].dt.date).agg(
        case_count=('claim_no', 'count'),
        total_amount=('settlement_amount', 'sum')
    ).reset_index().rename(columns={'report_date': 'date'})
    daily_stats['date'] = daily_stats['date'].astype(str)
    
    # 按周统计（ISO周）
    df['week'] = df['report_date'].dt.isocalendar().week
    df['year'] = df['report_date'].dt.year
    weekly_stats = df.groupby(['year', 'week']).agg(
        case_count=('claim_no', 'count'),
        total_amount=('settlement_amount', 'sum')
    ).reset_index()
    weekly_stats['week_range'] = weekly_stats.apply(lambda x: f"{x['year']}-W{x['week']}", axis=1)
    
    # 按月统计
    df['month'] = df['report_date'].dt.month
    monthly_stats = df.groupby(['year', 'month']).agg(
        case_count=('claim_no', 'count'),
        total_amount=('settlement_amount', 'sum')
    ).reset_index()
    monthly_stats['month_range'] = monthly_stats.apply(lambda x: f"{x['year']}-{x['month']:02d}", axis=1)
    
    return {
        "policy_stats": policy_stats,
        "insured_stats": insured_stats,
        "account_stats": account_stats,
        "daily_stats": daily_stats.to_dict('records') if not daily_stats.empty else [],
        "weekly_stats": weekly_stats[['week_range', 'case_count', 'total_amount']].to_dict('records') if not weekly_stats.empty else [],
        "monthly_stats": monthly_stats[['month_range', 'case_count', 'total_amount']].to_dict('records') if not monthly_stats.empty else []
    }

def call_deepseek_analysis(api_key, model_text, group_stats, all_cases):
    """
    调用DeepSeek API，基于分组统计数据和用户模型输入，识别可疑案件和异常时间段
    """
    if not api_key:
        return {"error": "缺少DeepSeek API Key"}
    
    client = get_deepseek_client(api_key)
    if not client:
        return {"error": "DeepSeek客户端初始化失败"}
    
    # 构建系统提示
    system_prompt = """你是一个专业的保险理赔反欺诈分析专家。根据提供的理赔案件分组统计数据，识别出可能存在欺诈风险的案件。
    
分析要求：
1. 对于同一保单号下的多起案件，分析是否存在理赔金额显著偏高或理赔频率异常（短时间内多次出险）。
2. 对于同一被保险人（保险标的）下的案件，分析金额或频率是否异常。
3. 对于同一收款账号下的案件，分析金额或频率是否异常。
4. 对于按天、周、月统计的整体案件量及金额，分析是否存在异常的时间段（如突然激增或与常规波动不符）。

请返回严格的JSON格式，包含两个字段：
- suspected_claim_ids: 可疑案件的报案号列表（字符串数组）
- abnormal_time_periods: 异常时间段列表，每个元素为字符串描述，例如 ["2025-01-15 数量异常", "2025年第3周金额异常", "2025-02月频率异常"]

仅返回JSON，不要有其他内容。"""
    
    # 构建用户提示
    user_prompt = f"""用户自定义模型规则/说明：{model_text}

以下是当前所有理赔案件的基本信息（共{len(all_cases)}件）：
案件明细（仅报案号、保单号、被保险人、收款账号、理赔金额、报案日期）：
{json.dumps([{"claim_no": c["claim_no"], "policy_no": c["policy_no"], "insured": c["insured"], "receiver_account": c["receiver_account"], "settlement_amount": c["settlement_amount"], "report_date": c.get("report_date", "未知")} for c in all_cases], ensure_ascii=False, indent=2)}

分组统计摘要：
1. 按保单号分组统计：
{json.dumps(group_stats['policy_stats'], ensure_ascii=False, indent=2)}

2. 按被保险人（保险标的）分组统计：
{json.dumps(group_stats['insured_stats'], ensure_ascii=False, indent=2)}

3. 按收款账号分组统计：
{json.dumps(group_stats['account_stats'], ensure_ascii=False, indent=2)}

4. 按天统计：
{json.dumps(group_stats['daily_stats'], ensure_ascii=False, indent=2)}

5. 按周统计：
{json.dumps(group_stats['weekly_stats'], ensure_ascii=False, indent=2)}

6. 按月统计：
{json.dumps(group_stats['monthly_stats'], ensure_ascii=False, indent=2)}

请根据以上数据，结合用户模型规则，找出所有可疑案件（返回报案号列表）和异常时间段（时间粒度根据情况可以是天、周、月）。"""
    
    try:
        response = client.chat.completions.create(
            model="deepseek-chat",
            messages=[
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt}
            ],
            temperature=0.3,
            response_format={"type": "json_object"}
        )
        content = response.choices[0].message.content
        result = json.loads(content)
        return result
    except Exception as e:
        return {"error": f"DeepSeek调用失败: {str(e)}"}

