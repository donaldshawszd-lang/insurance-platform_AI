@app.route('/api/cases', methods=['GET'])
def get_cases():
    cases = get_all_cases()
    return jsonify(cases)

@app.route('/api/cases', methods=['POST'])
def add_case_api():
    data = request.json
    # 补全缺失字段默认值
    required_fields = ['claim_no', 'policy_no', 'insured', 'applicant', 'receiver_account', 'product_name',
                       'product_code', 'insurance_name', 'insurance_code', 'sum_insured', 'deductible', 
                       '赔付比例', 'reported_amount', 'settlement_amount']
    for f in required_fields:
        if f not in data:
            data[f] = '' if f not in ['sum_insured','deductible','赔付比例','reported_amount','settlement_amount'] else 0.0
    if 'report_date' not in data or not data['report_date']:
        data['report_date'] = datetime.now().strftime('%Y-%m-%d')
    success = add_case(data)
    if success:
        return jsonify({"message": "案件添加成功"}), 201
    else:
        return jsonify({"error": "报案号已存在"}), 400

@app.route('/api/cases/<claim_no>', methods=['DELETE'])
def delete_case_api(claim_no):
    delete_case(claim_no)
    return jsonify({"message": "删除成功"})

@app.route('/api/upload', methods=['POST'])
def upload_csv():
    if 'file' not in request.files:
        return jsonify({"error": "未上传文件"}), 400
    file = request.files['file']
    if file.filename == '':
        return jsonify({"error": "文件名为空"}), 400
    try:
        df = pd.read_csv(file)
        # 标准化列名映射
        column_mapping = {
            '报案号': 'claim_no', '保单号': 'policy_no', '被保险人': 'insured', '投保人': 'applicant',
            '收款账号': 'receiver_account', '产品名称': 'product_name', '产品代码': 'product_code',
            '险种名称': 'insurance_name', '险种代码': 'insurance_code', '保额': 'sum_insured',
            '免赔额': 'deductible', '赔付比例': '赔付比例', '报案金额': 'reported_amount',
            '理赔金额': 'settlement_amount', '报案日期': 'report_date'
        }
        df.rename(columns=column_mapping, inplace=True)
        required = ['claim_no', 'policy_no', 'insured', 'applicant', 'receiver_account', 'product_name',
                    'product_code', 'insurance_name', 'insurance_code', 'sum_insured', 'deductible',
                    '赔付比例', 'reported_amount', 'settlement_amount']
        for col in required:
            if col not in df.columns:
                df[col] = '' if col not in ['sum_insured','deductible','赔付比例','reported_amount','settlement_amount'] else 0.0
        if 'report_date' not in df.columns:
            df['report_date'] = datetime.now().strftime('%Y-%m-%d')
        # 逐个插入
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        success_count = 0
        for _, row in df.iterrows():
            try:
                c.execute('''INSERT INTO claims VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)''',
                          (row['claim_no'], row['policy_no'], row['insured'], row['applicant'],
                           row['receiver_account'], row['product_name'], row['product_code'],
                           row['insurance_name'], row['insurance_code'], float(row['sum_insured']),
                           float(row['deductible']), float(row['赔付比例']), float(row['reported_amount']),
                           float(row['settlement_amount']), row['report_date']))
                success_count += 1
            except sqlite3.IntegrityError:
                continue
        conn.commit()
        conn.close()
        return jsonify({"message": f"上传完成，成功添加 {success_count} 条，重复跳过"}), 200
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route('/api/detect', methods=['POST'])
